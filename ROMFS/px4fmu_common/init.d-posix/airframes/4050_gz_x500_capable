#!/bin/sh
#
# @name Gazebo x500_capable (x500 look, MATH_Rishabh.pdf Table II physics)
#
# @type Quadrotor
#
# Mass 3.0 kg, inertia 0.025/0.025/0.046, 44.13 N per rotor (T/W 6.0), yaw ratio 0.019941,
# linear drag 0.54 N s/m. Rotor arms stay at the x500's +-0.174 m (roll authority 15.4 N m).
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_capable}

param set-default SIM_GZ_EN 1

# Rotor geometry in PHYSICAL units (capable_control mixes with it): same order/signs as 4001.
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.174
param set-default CA_ROTOR0_PY 0.174
param set-default CA_ROTOR0_KM 0.019941
param set-default CA_ROTOR1_PX -0.174
param set-default CA_ROTOR1_PY -0.174
param set-default CA_ROTOR1_KM 0.019941
param set-default CA_ROTOR2_PX 0.174
param set-default CA_ROTOR2_PY -0.174
param set-default CA_ROTOR2_KM -0.019941
param set-default CA_ROTOR3_PX -0.174
param set-default CA_ROTOR3_PY 0.174
param set-default CA_ROTOR3_KM -0.019941

# Motor outputs = rotor speed in rad/s, 0..2272 (linear). THR_MDL_FAC 1 makes PX4's output
# stage convert a thrust fraction f into speed fraction sqrt(f), for PX4's own controllers and
# for capable_control alike (so CC_THR_MODEL stays 0 = linear thrust fraction).
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MAX1 2272
param set-default SIM_GZ_EC_MAX2 2272
param set-default SIM_GZ_EC_MAX3 2272
param set-default SIM_GZ_EC_MAX4 2272
param set-default THR_MDL_FAC 1.0
param set-default MPC_THR_HOVER 0.1667

param set-default CC_ROT_FMAX 44.13
param set-default CC_THR_MODEL 0
# Ground truth for capable_control -t: *_groundtruth topics, which gz_bridge builds from the
# model's exact 250 Hz pose (PosePublisher), same path as SIH. (CC_TRUTH_SRC 1 = the
# OdometryPublisher via vehicle_visual_odometry; inexact twist, kept only for comparison.)
param set-default CC_TRUTH_SRC 0
param set-default EKF2_EV_CTRL 0

# Same standalone-control / logging settings as 10050
param set-default NAV_DLL_ACT 0
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1
param set-default SDLOG_PROFILE 17
