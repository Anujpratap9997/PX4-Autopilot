#!/bin/sh
#
# @name Gazebo x500_real (Holybro X500 V2 twin for capable_control free flight)
#
# @type Quadrotor
#
# 2.75 kg, inertia 0.025/0.025/0.045, 11.5 N per rotor (T/W 1.7), yaw ratio 0.0139, motor lag 50 ms.
# capable_control values as hardware airframe 4951 (rotor arms: the gz x500's 0.174 m).
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_real}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.174
param set-default CA_ROTOR0_PY 0.174
param set-default CA_ROTOR0_KM 0.0139
param set-default CA_ROTOR1_PX -0.174
param set-default CA_ROTOR1_PY -0.174
param set-default CA_ROTOR1_KM 0.0139
param set-default CA_ROTOR2_PX 0.174
param set-default CA_ROTOR2_PY -0.174
param set-default CA_ROTOR2_KM -0.0139
param set-default CA_ROTOR3_PX -0.174
param set-default CA_ROTOR3_PY 0.174
param set-default CA_ROTOR3_KM -0.0139

# Motor outputs = rotor speed in rad/s, 0..1160 (linear); THR_MDL_FAC 1: thrust fraction f -> speed sqrt(f)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MAX1 1160
param set-default SIM_GZ_EC_MAX2 1160
param set-default SIM_GZ_EC_MAX3 1160
param set-default SIM_GZ_EC_MAX4 1160
param set-default THR_MDL_FAC 1.0
param set-default MPC_THR_HOVER 0.586

# capable_control: vehicle
param set-default CC_ROT_FMAX 11.5
param set-default CC_THR_MODEL 0
param set-default CC_MASS 2.75
param set-default CC_IXX 0.025
param set-default CC_IYY 0.025
param set-default CC_IZZ 0.045
param set-default CC_DRAG 0.10
# capable_control: limits for T/W 1.7 (the paper's vehicle: 5.5 and 4 g)
param set-default CC_TW_MAX 1.6
param set-default CC_ACC_MAX_G 1.0
param set-default CC_V_MAX 10.0
# capable_control: attitude law with the motor-lag fixes, soft gains for first flights
param set-default CC_MOT_TAU 0.053
param set-default CC_ATT_MODE 3
param set-default CC_ATT_WN 8.0
param set-default CC_ATT_ZETA 1.0
param set-default CC_RIG_EN 0
param set-default CC_TRUTH_SRC 0
param set-default EKF2_EV_CTRL 0

# standalone-control / logging settings as 10050 (chained SITL runs)
param set-default NAV_DLL_ACT 0
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1
param set-default SDLOG_PROFILE 17
